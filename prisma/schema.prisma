generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["dbo", "dim", "dm_atencion", "dm_comercial", "dm_entrenamiento"]
}

model DimCliente {
  sk_cliente                Int                         @id(map: "PK_DimCliente") @default(autoincrement())
  sk_cliente_origen         Int?
  id_cliente_bk             Int                         @unique(map: "UQ_DimCliente_IdClienteBk")
  dni                       String?                     @db.VarChar(8)
  nombre_completo           String                      @db.VarChar(250)
  sexo                      String                      @db.Char(1)
  rango_etario              String?                     @db.VarChar(50)
  estado_cliente            String                      @db.VarChar(30)
  fecha_registro_origen     DateTime?                   @db.Date
  fecha_inicio_validez      DateTime?                   @db.Date
  fecha_fin_validez         DateTime?                   @db.Date
  es_actual                 Boolean
  FactAsistencias           FactAsistencias[]
  FactMembresias            FactMembresias[]
  FactReclamos              FactReclamos[]
  FactRetenciones           FactRetenciones[]
  FactSeguimientoFisico     FactSeguimientoFisico[]
  FactSesionesEntrenamiento FactSesionesEntrenamiento[]
  FactVentas                FactVentas[]

  @@schema("dim")
}

model DimEmpleado {
  sk_empleado               Int                         @id(map: "PK_DimEmpleado") @default(autoincrement())
  sk_empleado_origen        Int?
  id_empleado_bk            Int                         @unique(map: "UQ_DimEmpleado_IdEmpleadoBk")
  codigo_empleado           String                      @unique(map: "UQ_DimEmpleado_Codigo") @db.VarChar(20)
  dni                       String?                     @db.VarChar(20)
  nombre_completo           String                      @db.VarChar(250)
  cargo                     String                      @db.VarChar(60)
  area                      String                      @db.VarChar(60)
  FactAsistencias           FactAsistencias[]
  FactMembresias            FactMembresias[]
  FactReclamos              FactReclamos[]
  FactRetenciones           FactRetenciones[]
  FactSeguimientoFisico     FactSeguimientoFisico[]
  FactSesionesEntrenamiento FactSesionesEntrenamiento[]
  FactVentas                FactVentas[]

  @@schema("dim")
}

model DimFecha {
  sk_fecha                             Int                         @id(map: "PK_DimFecha")
  fecha                                DateTime                    @unique(map: "UQ_DimFecha_Fecha") @db.Date
  anio                                 Int
  trimestre                            Int
  semestre                             Int
  mes                                  Int
  nombre_mes                           String                      @db.VarChar(30)
  dia                                  Int
  dia_semana                           String                      @db.VarChar(30)
  es_fin_de_semana                     Boolean
  FactAsistencias                      FactAsistencias[]
  FactMembresiasAviso                  FactMembresias[]            @relation("FactMembresiasAviso")
  FactMembresiasCorte                  FactMembresias[]            @relation("FactMembresiasCorte")
  FactMembresiasFin                    FactMembresias[]            @relation("FactMembresiasFin")
  FactMembresiasInicio                 FactMembresias[]            @relation("FactMembresiasInicio")
  FactMembresiasRenovacion             FactMembresias[]            @relation("FactMembresiasRenovacion")
  FactReclamosApertura                 FactReclamos[]              @relation("FactReclamosApertura")
  FactReclamosCierre                   FactReclamos[]              @relation("FactReclamosCierre")
  FactReclamosResolucion               FactReclamos[]              @relation("FactReclamosResolucion")
  FactRetencionesAccion                FactRetenciones[]           @relation("FactRetencionesAccion")
  FactRetencionesVencimiento           FactRetenciones[]           @relation("FactRetencionesVencimiento")
  FactSeguimientoFisicoCorte           FactSeguimientoFisico[]     @relation("FactSeguimientoFisicoCorte")
  FactSeguimientoFisicoInicio          FactSeguimientoFisico[]     @relation("FactSeguimientoFisicoInicio")
  FactSeguimientoFisicoMeta            FactSeguimientoFisico[]     @relation("FactSeguimientoFisicoMeta")
  FactSesionesEntrenamientoProgramada  FactSesionesEntrenamiento[] @relation("FactSesionesEntrenamientoProgramada")
  FactSesionesEntrenamientoCancelacion FactSesionesEntrenamiento[] @relation("FactSesionesEntrenamientoCancelacion")
  FactVentas                           FactVentas[]

  @@schema("dim")
}

model DimPlan {
  sk_plan                   Int                         @id(map: "PK_DimPlan") @default(autoincrement())
  tipo_plan                 String                      @db.VarChar(40)
  tipo_operacion            String                      @db.VarChar(40)
  promocion                 String                      @db.VarChar(100)
  FactAsistencias           FactAsistencias[]
  FactMembresias            FactMembresias[]
  FactRetenciones           FactRetenciones[]
  FactSesionesEntrenamiento FactSesionesEntrenamiento[]
  FactVentas                FactVentas[]

  @@unique([tipo_plan, tipo_operacion, promocion], map: "UQ_DimPlan_Combinacion")
  @@schema("dim")
}

/// Grano: un pago confirmado (id_pago_bk). Fecha de análisis: la del cobro.
model FactVentas {
  sk_venta           BigInt      @id(map: "PK_FactVentas") @default(autoincrement())
  id_pago_bk         Int         @unique(map: "UQ_FactVentas_IdPagoBk")
  sk_fecha_pago      Int
  sk_cliente         Int
  sk_plan            Int
  sk_empleado        Int
  id_membresia_bk    Int?
  monto_neto         Decimal     @db.Decimal(12, 2)
  descuento_aplicado Decimal?    @db.Decimal(12, 2)
  precio_lista       Decimal?    @db.Decimal(12, 2)
  metodo_pago        String      @db.VarChar(50)
  DimCliente         DimCliente  @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactVentas_DimCliente")
  DimEmpleado        DimEmpleado @relation(fields: [sk_empleado], references: [sk_empleado], onUpdate: NoAction, map: "FK_FactVentas_DimEmpleado")
  DimFecha           DimFecha    @relation(fields: [sk_fecha_pago], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactVentas_DimFecha")
  DimPlan            DimPlan     @relation(fields: [sk_plan], references: [sk_plan], onUpdate: NoAction, map: "FK_FactVentas_DimPlan")

  @@index([sk_fecha_pago], map: "IX_FactVentas_Fecha")
  @@schema("dm_comercial")
}

/// Grano: una membresía de un cliente en una fecha de corte diaria
/// (id_membresia_bk + sk_fecha_corte). Absorbe renovaciones y avisos.
model FactMembresias {
  sk_membresia                 BigInt      @id(map: "PK_FactMembresias") @default(autoincrement())
  id_membresia_bk              Int
  sk_fecha_corte               Int
  sk_cliente                   Int
  sk_plan                      Int
  sk_empleado                  Int
  sk_fecha_inicio              Int
  sk_fecha_fin                 Int
  duracion_dias                Int?
  precio_final                 Decimal?    @db.Decimal(12, 2)
  estado_membresia             String      @db.VarChar(30)
  dias_desde_vencimiento       Int?
  es_renovacion                Boolean
  id_membresia_anterior_bk     Int?
  id_membresia_nueva_bk        Int?
  sk_fecha_renovacion          Int?
  dias_anticipacion_renovacion Int?
  monto_renovacion             Decimal?    @db.Decimal(12, 2)
  aviso_emitido                Boolean
  sk_fecha_aviso               Int?
  dias_antes_vencimiento       Int?
  medio_aviso                  String?     @db.VarChar(30)
  estado_aviso                 String?     @db.VarChar(30)
  avisos_emitidos_dia          Int
  DimCliente                   DimCliente  @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactMembresias_DimCliente")
  DimEmpleado                  DimEmpleado @relation(fields: [sk_empleado], references: [sk_empleado], onUpdate: NoAction, map: "FK_FactMembresias_DimEmpleado")
  DimFechaAviso                DimFecha?   @relation("FactMembresiasAviso", fields: [sk_fecha_aviso], references: [sk_fecha], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactMembresias_DimFechaAviso")
  DimFechaCorte                DimFecha    @relation("FactMembresiasCorte", fields: [sk_fecha_corte], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactMembresias_DimFechaCorte")
  DimFechaFin                  DimFecha    @relation("FactMembresiasFin", fields: [sk_fecha_fin], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactMembresias_DimFechaFin")
  DimFechaInicio               DimFecha    @relation("FactMembresiasInicio", fields: [sk_fecha_inicio], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactMembresias_DimFechaInicio")
  DimFechaRenovacion           DimFecha?   @relation("FactMembresiasRenovacion", fields: [sk_fecha_renovacion], references: [sk_fecha], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactMembresias_DimFechaRenovacion")
  DimPlan                      DimPlan     @relation(fields: [sk_plan], references: [sk_plan], onUpdate: NoAction, map: "FK_FactMembresias_DimPlan")

  @@unique([id_membresia_bk, sk_fecha_corte], map: "UQ_FactMembresias_Grano")
  @@index([sk_fecha_corte, estado_membresia], map: "IX_FactMembresias_Corte")
  @@schema("dm_comercial")
}

/// Grano: una marcación real de acceso al gimnasio (id_asistencia_bk).
model FactAsistencias {
  sk_asistencia        BigInt      @id(map: "PK_FactAsistencias") @default(autoincrement())
  id_asistencia_bk     Int         @unique(map: "UQ_FactAsistencias_IdAsistenciaBk")
  sk_fecha_asistencia  Int
  sk_cliente           Int
  sk_plan              Int
  sk_empleado          Int
  hora_ingreso         Int?
  cantidad_asistencias Int
  es_acceso_valido     Boolean
  DimCliente           DimCliente  @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactAsistencias_DimCliente")
  DimEmpleado          DimEmpleado @relation(fields: [sk_empleado], references: [sk_empleado], onUpdate: NoAction, map: "FK_FactAsistencias_DimEmpleado")
  DimFecha             DimFecha    @relation(fields: [sk_fecha_asistencia], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactAsistencias_DimFecha")
  DimPlan              DimPlan     @relation(fields: [sk_plan], references: [sk_plan], onUpdate: NoAction, map: "FK_FactAsistencias_DimPlan")

  @@index([sk_fecha_asistencia], map: "IX_FactAsistencias_Fecha")
  @@schema("dm_entrenamiento")
}

/// Grano: una sesión programada (id_sesion_bk), con su cancelación y resultado.
model FactSesionesEntrenamiento {
  sk_sesion            BigInt      @id(map: "PK_FactSesionesEntrenamiento") @default(autoincrement())
  id_sesion_bk         Int         @unique(map: "UQ_FactSesionesEntrenamiento_IdSesionBk")
  sk_fecha_programada  Int
  sk_cliente           Int
  sk_plan              Int
  sk_empleado          Int
  tipo_sesion          String      @db.VarChar(40)
  hora_programada      Int?
  estado_sesion        String      @db.VarChar(30)
  asistio              Boolean
  duracion_minutos     Int?
  sk_fecha_cancelacion Int?
  motivo_cancelacion   String?     @db.VarChar(60)
  DimCliente           DimCliente  @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactSesionesEntrenamiento_DimCliente")
  DimEmpleado          DimEmpleado @relation(fields: [sk_empleado], references: [sk_empleado], onUpdate: NoAction, map: "FK_FactSesionesEntrenamiento_DimEmpleado")
  DimFechaProgramada   DimFecha    @relation("FactSesionesEntrenamientoProgramada", fields: [sk_fecha_programada], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactSesionesEntrenamiento_DimFecha")
  DimFechaCancelacion  DimFecha?   @relation("FactSesionesEntrenamientoCancelacion", fields: [sk_fecha_cancelacion], references: [sk_fecha], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactSesionesEntrenamiento_DimFechaCancelacion")
  DimPlan              DimPlan     @relation(fields: [sk_plan], references: [sk_plan], onUpdate: NoAction, map: "FK_FactSesionesEntrenamiento_DimPlan")

  @@index([sk_fecha_programada], map: "IX_FactSesiones_Fecha")
  @@schema("dm_entrenamiento")
}

/// Grano: un cliente, un objetivo y una fecha de corte diaria.
/// Consolida objetivos, evaluaciones y evaluaciones programadas.
model FactSeguimientoFisico {
  sk_seguimiento              BigInt      @id(map: "PK_FactSeguimientoFisico") @default(autoincrement())
  id_objetivo_bk              Int
  sk_cliente                  Int
  sk_empleado                 Int
  sk_fecha_corte              Int
  sk_fecha_inicio             Int
  sk_fecha_meta               Int
  id_evaluacion_bk            Int?
  id_evaluacion_programada_bk Int?
  tipo_objetivo               String      @db.VarChar(60)
  unidad_medida               String      @db.VarChar(30)
  estado_objetivo             String      @db.VarChar(30)
  valor_inicial               Decimal?    @db.Decimal(10, 2)
  valor_actual                Decimal?    @db.Decimal(10, 2)
  valor_esperado              Decimal?    @db.Decimal(10, 2)
  avance_alcanzado            Decimal?    @db.Decimal(10, 2)
  avance_esperado             Decimal?    @db.Decimal(10, 2)
  porcentaje_progreso         Decimal?    @db.Decimal(9, 2)
  peso                        Decimal?    @db.Decimal(8, 2)
  altura                      Decimal?    @db.Decimal(8, 2)
  grasa_corporal              Decimal?    @db.Decimal(8, 2)
  masa_muscular               Decimal?    @db.Decimal(8, 2)
  evaluacion_exigible         Boolean
  evaluacion_completada       Boolean
  evaluacion_pendiente        Boolean
  estado_evaluacion           String      @db.VarChar(30)
  DimCliente                  DimCliente  @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactSeguimientoFisico_DimCliente")
  DimEmpleado                 DimEmpleado @relation(fields: [sk_empleado], references: [sk_empleado], onUpdate: NoAction, map: "FK_FactSeguimientoFisico_DimEmpleado")
  DimFechaCorte               DimFecha    @relation("FactSeguimientoFisicoCorte", fields: [sk_fecha_corte], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactSeguimientoFisico_DimFechaCorte")
  DimFechaInicio              DimFecha    @relation("FactSeguimientoFisicoInicio", fields: [sk_fecha_inicio], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactSeguimientoFisico_DimFechaInicio")
  DimFechaMeta                DimFecha    @relation("FactSeguimientoFisicoMeta", fields: [sk_fecha_meta], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactSeguimientoFisico_DimFechaMeta")

  @@unique([sk_cliente, id_objetivo_bk, sk_fecha_corte], map: "UQ_FactSeguimientoFisico_Grano")
  @@index([sk_fecha_corte, id_objetivo_bk], map: "IX_FactSeguimiento_Corte")
  @@schema("dm_entrenamiento")
}

/// Grano: un reclamo registrado (id_reclamo_bk), con sus hitos de resolución.
model FactReclamos {
  sk_reclamo            BigInt      @id(map: "PK_FactReclamos") @default(autoincrement())
  id_reclamo_bk         Int         @unique(map: "UQ_FactReclamos_IdReclamoBk")
  sk_fecha_reclamo      Int
  sk_cliente            Int
  sk_empleado           Int
  categoria             String      @db.VarChar(60)
  estado                String      @db.VarChar(30)
  sk_fecha_resolucion   Int?
  sk_fecha_cierre       Int?
  dias_resolucion       Int?
  resuelto_en_mostrador Boolean?
  escalado              Boolean
  area_responsable      String?     @db.VarChar(60)
  DimCliente            DimCliente  @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactReclamos_DimCliente")
  DimEmpleado           DimEmpleado @relation(fields: [sk_empleado], references: [sk_empleado], onUpdate: NoAction, map: "FK_FactReclamos_DimEmpleado")
  DimFechaApertura      DimFecha    @relation("FactReclamosApertura", fields: [sk_fecha_reclamo], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactReclamos_DimFecha")
  DimFechaCierre        DimFecha?   @relation("FactReclamosCierre", fields: [sk_fecha_cierre], references: [sk_fecha], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactReclamos_DimFechaCierre")
  DimFechaResolucion    DimFecha?   @relation("FactReclamosResolucion", fields: [sk_fecha_resolucion], references: [sk_fecha], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactReclamos_DimFechaResolucion")

  @@index([sk_fecha_reclamo], map: "IX_FactReclamos_Fecha")
  @@schema("dm_atencion")
}

/// Grano: una acción de retención ejecutada (id_retencion_bk).
model FactRetenciones {
  sk_retencion         BigInt      @id(map: "PK_FactRetenciones") @default(autoincrement())
  id_retencion_bk      Int         @unique(map: "UQ_FactRetenciones_IdRetencionBk")
  sk_fecha_retencion   Int
  sk_cliente           Int
  sk_empleado          Int
  sk_plan              Int
  id_membresia_bk      Int?
  sk_fecha_vencimiento Int?
  canal                String      @db.VarChar(40)
  motivo               String      @db.VarChar(60)
  resultado            String      @db.VarChar(30)
  recuperada           Boolean
  monto_oferta         Decimal?    @db.Decimal(12, 2)
  DimCliente           DimCliente  @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactRetenciones_DimCliente")
  DimEmpleado          DimEmpleado @relation(fields: [sk_empleado], references: [sk_empleado], onUpdate: NoAction, map: "FK_FactRetenciones_DimEmpleado")
  DimFechaAccion       DimFecha    @relation("FactRetencionesAccion", fields: [sk_fecha_retencion], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactRetenciones_DimFecha")
  DimFechaVencimiento  DimFecha?   @relation("FactRetencionesVencimiento", fields: [sk_fecha_vencimiento], references: [sk_fecha], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactRetenciones_DimFechaVencimiento")
  DimPlan              DimPlan     @relation(fields: [sk_plan], references: [sk_plan], onUpdate: NoAction, map: "FK_FactRetenciones_DimPlan")

  @@index([sk_fecha_retencion], map: "IX_FactRetenciones_Fecha")
  @@schema("dm_atencion")
}

/// Marcas de agua del ETL. Incluye las dos marcas de snapshot diario.
model etl_control {
  proceso            String    @id(map: "PK_etl_control") @db.NVarChar(128)
  ultimo_staging_id  BigInt    @default(0, map: "DF_etl_control_ultimo_staging_id")
  ultima_carga       DateTime?
  filas_ultima_carga BigInt?

  @@schema("dbo")
}
