generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["dim", "dm_atencion"]
}

model DimCliente {
  sk_cliente            Int               @id(map: "PK__DimClien__78CB69CC2D0A9BFA") @default(autoincrement())
  sk_cliente_origen     Int?
  id_cliente_bk         Int               @unique(map: "UQ__DimClien__C039A18CE7620A06")
  dni                   String?           @db.VarChar(8)
  nombre_completo       String            @db.VarChar(250)
  sexo                  String            @db.Char(1)
  rango_etario          String?           @db.VarChar(50)
  estado_cliente        String            @db.VarChar(30)
  fecha_registro_origen DateTime?         @db.Date
  fecha_inicio_validez  DateTime?         @db.Date
  fecha_fin_validez     DateTime?         @db.Date
  es_actual             Boolean
  FactReclamos          FactReclamos[]
  FactRetenciones       FactRetenciones[]

  @@schema("dim")
}

model DimEmpleado {
  sk_empleado        Int               @id(map: "PK__DimEmple__FED8200F528EF1C3") @default(autoincrement())
  sk_empleado_origen Int?
  id_empleado_bk     Int               @unique(map: "UQ__DimEmple__57309A2980CC7A8E")
  dni                String?           @db.VarChar(20)
  nombre_completo    String            @db.VarChar(250)
  cargo              String            @db.VarChar(60)
  area               String            @db.VarChar(60)
  FactReclamos       FactReclamos[]
  FactRetenciones    FactRetenciones[]

  @@schema("dim")
}

model DimFecha {
  sk_fecha         Int               @id(map: "PK__DimFecha__18FB76FFED5E26D7")
  fecha            DateTime          @unique(map: "UQ__DimFecha__E114132289E169C1") @db.Date
  anio             Int
  trimestre        Int
  semestre         Int
  mes              Int
  nombre_mes       String            @db.VarChar(30)
  dia              Int
  dia_semana       String            @db.VarChar(30)
  es_fin_de_semana Boolean
  FactReclamos     FactReclamos[]
  FactRetenciones  FactRetenciones[]

  @@schema("dim")
}

model DimPlan {
  sk_plan            Int      @id(map: "PK__DimPlan__FF3965EFE9A9A235") @default(autoincrement())
  sk_plan_origen     Int?
  id_plan_bk         Int      @unique(map: "UQ__DimPlan__EF48987BD4D604EC")
  nombre_plan        String   @db.VarChar(60)
  duracion_dias      Int?
  precio_referencial Decimal? @db.Decimal(12, 2)
  categoria_duracion String?  @db.VarChar(40)

  @@schema("dim")
}

model DimPromocion {
  sk_promocion        Int      @id(map: "PK__DimPromo__1966EB6105F44DA2") @default(autoincrement())
  sk_promocion_origen Int?
  id_promocion_bk     Int      @unique(map: "UQ__DimPromo__A06792226CD53C3A")
  nombre_promocion    String   @db.VarChar(100)
  tipo_descuento      String   @db.VarChar(30)
  valor_descuento     Decimal? @db.Decimal(12, 2)

  @@schema("dim")
}

model FactReclamos {
  sk_reclamo            BigInt       @id(map: "PK__FactRecl__E753C5315AF5FE05") @default(autoincrement())
  id_reclamo_bk         Int          @unique(map: "UQ__FactRecl__2316A17D424FC7AC")
  sk_fecha_reclamo      Int
  sk_cliente            Int
  sk_empleado           Int?
  categoria             String       @db.VarChar(60)
  estado                String       @db.VarChar(30)
  fecha_resolucion      DateTime?
  dias_resolucion       Int?
  resuelto_en_mostrador Boolean?
  DimCliente            DimCliente   @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactReclamos_DimCliente")
  DimEmpleado           DimEmpleado? @relation(fields: [sk_empleado], references: [sk_empleado], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactReclamos_DimEmpleado")
  DimFecha              DimFecha     @relation(fields: [sk_fecha_reclamo], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactReclamos_DimFecha")

  @@schema("dm_atencion")
}

model FactRetenciones {
  sk_retencion       BigInt       @id(map: "PK__FactRete__EE14035B05F2A4D8") @default(autoincrement())
  id_retencion_bk    Int          @unique(map: "UQ__FactRete__63F7F98D0CDD88AC")
  sk_fecha_retencion Int
  sk_cliente         Int
  sk_empleado        Int?
  id_membresia_bk    Int?
  canal              String       @db.VarChar(40)
  motivo             String       @db.VarChar(60)
  resultado          String       @db.VarChar(30)
  monto_oferta       Decimal?     @db.Decimal(12, 2)
  DimCliente         DimCliente   @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactRetenciones_DimCliente")
  DimEmpleado        DimEmpleado? @relation(fields: [sk_empleado], references: [sk_empleado], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactRetenciones_DimEmpleado")
  DimFecha           DimFecha     @relation(fields: [sk_fecha_retencion], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactRetenciones_DimFecha")

  @@schema("dm_atencion")
}
