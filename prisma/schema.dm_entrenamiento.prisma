generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
  schemas  = ["dim", "dm_entrenamiento"]
}

model DimCliente {
  sk_cliente                  Int                           @id(map: "PK__DimClien__78CB69CC2D0A9BFA") @default(autoincrement())
  sk_cliente_origen           Int?
  id_cliente_bk               Int                           @unique(map: "UQ__DimClien__C039A18CE7620A06")
  dni                         String?                       @db.VarChar(8)
  nombre_completo             String                        @db.VarChar(250)
  sexo                        String                        @db.Char(1)
  rango_etario                String?                       @db.VarChar(50)
  estado_cliente              String                        @db.VarChar(30)
  fecha_registro_origen       DateTime?                     @db.Date
  fecha_inicio_validez        DateTime?                     @db.Date
  fecha_fin_validez           DateTime?                     @db.Date
  es_actual                   Boolean
  FactAsistencias             FactAsistencias[]
  FactEvaluaciones            FactEvaluaciones[]
  FactEvaluacionesProgramadas FactEvaluacionesProgramadas[]
  FactObjetivos               FactObjetivos[]
  FactSesionesProgramadas     FactSesionesProgramadas[]

  @@schema("dim")
}

model DimEmpleado {
  sk_empleado                 Int                           @id(map: "PK__DimEmple__FED8200F528EF1C3") @default(autoincrement())
  sk_empleado_origen          Int?
  id_empleado_bk              Int                           @unique(map: "UQ__DimEmple__57309A2980CC7A8E")
  dni                         String?                       @db.VarChar(20)
  nombre_completo             String                        @db.VarChar(250)
  cargo                       String                        @db.VarChar(60)
  area                        String                        @db.VarChar(60)
  FactAsistencias             FactAsistencias[]
  FactEvaluaciones            FactEvaluaciones[]
  FactEvaluacionesProgramadas FactEvaluacionesProgramadas[]
  FactSesionesProgramadas     FactSesionesProgramadas[]

  @@schema("dim")
}

model DimFecha {
  sk_fecha                    Int                           @id(map: "PK__DimFecha__18FB76FFED5E26D7")
  fecha                       DateTime                      @unique(map: "UQ__DimFecha__E114132289E169C1") @db.Date
  anio                        Int
  trimestre                   Int
  semestre                    Int
  mes                         Int
  nombre_mes                  String                        @db.VarChar(30)
  dia                         Int
  dia_semana                  String                        @db.VarChar(30)
  es_fin_de_semana            Boolean
  FactAsistencias             FactAsistencias[]
  FactEvaluaciones            FactEvaluaciones[]
  FactEvaluacionesProgramadas FactEvaluacionesProgramadas[]
  FactObjetivos               FactObjetivos[]
  FactSesionesProgramadas     FactSesionesProgramadas[]

  @@schema("dim")
}

model DimPlan {
  sk_plan                 Int                       @id(map: "PK__DimPlan__FF3965EFE9A9A235") @default(autoincrement())
  sk_plan_origen          Int?
  id_plan_bk              Int                       @unique(map: "UQ__DimPlan__EF48987BD4D604EC")
  nombre_plan             String                    @db.VarChar(60)
  duracion_dias           Int?
  precio_referencial      Decimal?                  @db.Decimal(12, 2)
  categoria_duracion      String?                   @db.VarChar(40)
  FactAsistencias         FactAsistencias[]
  FactSesionesProgramadas FactSesionesProgramadas[]

  @@schema("dim")
}

model DimPromocion {
  sk_promocion        Int      @id(map: "PK__DimPromo__1966EB6105F44DA2") @default(autoincrement())
  sk_promocion_origen Int?
  id_promocion_bk     Int      @unique(map: "UQ__DimPromo__A06792226CD53C3A")
  nombre_promocion    String   @db.VarChar(100)
  tipo_descuento      String   @db.VarChar(30)
  valor_descuento     Decimal? @db.Decimal(12, 2)

  @@schema("dim")
}

model FactAsistencias {
  sk_asistencia        BigInt       @id(map: "PK__FactAsis__6980D61D7C51E991") @default(autoincrement())
  id_asistencia_bk     Int          @unique(map: "UQ__FactAsis__5D1FDF2D2BDD7733")
  sk_fecha_asistencia  Int
  sk_cliente           Int
  sk_plan              Int?
  sk_empleado          Int?
  hora_ingreso         Int?
  cantidad_asistencias Int
  DimCliente           DimCliente   @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactAsistencias_DimCliente")
  DimEmpleado          DimEmpleado? @relation(fields: [sk_empleado], references: [sk_empleado], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactAsistencias_DimEmpleado")
  DimFecha             DimFecha     @relation(fields: [sk_fecha_asistencia], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactAsistencias_DimFecha")
  DimPlan              DimPlan?     @relation(fields: [sk_plan], references: [sk_plan], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactAsistencias_DimPlan")

  @@schema("dm_entrenamiento")
}

model FactEvaluaciones {
  sk_evaluacion       BigInt       @id(map: "PK__FactEval__9008F83A44F6060F") @default(autoincrement())
  id_evaluacion_bk    Int          @unique(map: "UQ__FactEval__FF7F30E875C5B053")
  sk_fecha_evaluacion Int
  sk_cliente          Int
  sk_empleado         Int?
  id_objetivo_bk      Int?
  peso                Decimal?     @db.Decimal(8, 2)
  altura              Decimal?     @db.Decimal(8, 2)
  grasa_corporal      Decimal?     @db.Decimal(8, 2)
  masa_muscular       Decimal?     @db.Decimal(8, 2)
  DimCliente          DimCliente   @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactEvaluaciones_DimCliente")
  DimEmpleado         DimEmpleado? @relation(fields: [sk_empleado], references: [sk_empleado], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactEvaluaciones_DimEmpleado")
  DimFecha            DimFecha     @relation(fields: [sk_fecha_evaluacion], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactEvaluaciones_DimFecha")

  @@schema("dm_entrenamiento")
}

model FactEvaluacionesProgramadas {
  sk_evaluacion_programada    BigInt       @id(map: "PK__FactEval__5653127EA70F8C6A") @default(autoincrement())
  id_evaluacion_programada_bk Int          @unique(map: "UQ__FactEval__3F273B73C7EBBBBC")
  sk_fecha_programada         Int
  sk_cliente                  Int
  sk_empleado                 Int?
  id_objetivo_bk              Int?
  tipo_evaluacion             String       @db.VarChar(40)
  estado_evaluacion           String       @db.VarChar(30)
  id_evaluacion_bk            Int?
  DimCliente                  DimCliente   @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactEvaluacionesProgramadas_DimCliente")
  DimEmpleado                 DimEmpleado? @relation(fields: [sk_empleado], references: [sk_empleado], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactEvaluacionesProgramadas_DimEmpleado")
  DimFecha                    DimFecha     @relation(fields: [sk_fecha_programada], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactEvaluacionesProgramadas_DimFecha")

  @@schema("dm_entrenamiento")
}

model FactObjetivos {
  sk_objetivo     BigInt     @id(map: "PK__FactObje__71EFDB0F8B9B47E4") @default(autoincrement())
  id_objetivo_bk  Int        @unique(map: "UQ__FactObje__78C2C98C6D2EB447")
  sk_fecha_inicio Int
  sk_cliente      Int
  tipo_objetivo   String     @db.VarChar(60)
  valor_inicial   Decimal?   @db.Decimal(10, 2)
  valor_objetivo  Decimal?   @db.Decimal(10, 2)
  unidad_medida   String     @db.VarChar(30)
  estado          String     @db.VarChar(30)
  DimCliente      DimCliente @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactObjetivos_DimCliente")
  DimFecha        DimFecha   @relation(fields: [sk_fecha_inicio], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactObjetivos_DimFecha")

  @@schema("dm_entrenamiento")
}

model FactSesionesProgramadas {
  sk_sesion_programada BigInt       @id(map: "PK__FactSesi__623C583E4FC130C6") @default(autoincrement())
  id_sesion_bk         Int          @unique(map: "UQ__FactSesi__8C6204CCDEA36CC4")
  sk_fecha_programada  Int
  sk_cliente           Int
  sk_plan              Int?
  sk_empleado          Int?
  tipo_sesion          String       @db.VarChar(40)
  hora_programada      Int?
  estado_sesion        String       @db.VarChar(30)
  duracion_minutos     Int?
  DimCliente           DimCliente   @relation(fields: [sk_cliente], references: [sk_cliente], onUpdate: NoAction, map: "FK_FactSesionesProgramadas_DimCliente")
  DimEmpleado          DimEmpleado? @relation(fields: [sk_empleado], references: [sk_empleado], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactSesionesProgramadas_DimEmpleado")
  DimFecha             DimFecha     @relation(fields: [sk_fecha_programada], references: [sk_fecha], onUpdate: NoAction, map: "FK_FactSesionesProgramadas_DimFecha")
  DimPlan              DimPlan?     @relation(fields: [sk_plan], references: [sk_plan], onDelete: NoAction, onUpdate: NoAction, map: "FK_FactSesionesProgramadas_DimPlan")

  @@schema("dm_entrenamiento")
}
