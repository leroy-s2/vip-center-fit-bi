# Copiar a .env y ajustar. .env está en .gitignore.
#
# Contraseña del usuario sa del SQL Server en Docker.
# Debe cumplir la política de complejidad de SQL Server (mayúscula, minúscula,
# dígito y símbolo, mínimo 8 caracteres).
MSSQL_SA_PASSWORD=YourStrong!Passw0rd

# Puerto host para SQL Server. 14330 para no chocar con otras instancias en 1433.
MSSQL_PORT=14330

# Cadena de conexión para Prisma (provider = sqlserver).
# Base por defecto: el Data Mart (esquema estrella) -> la más útil para el UML.
DATABASE_URL="sqlserver://localhost:14330;database=BI_VIP_CENTER_FIT_DW;user=sa;password=YourStrong!Passw0rd;trustServerCertificate=true"

# Para estudiar otra capa, cambiá solo el valor de database= (y el puerto si aplica):
#   BI_VIP_CENTER_FIT_DW_ORIGEN   -> crudo + tablas CDC
#   BI_VIP_CENTER_FIT_STG         -> staging
